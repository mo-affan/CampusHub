# MySQL connection used by CampusHub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campushub

# Optional
DB_POOL_SIZE=5
# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and paste it here. Without it everyone is signed out whenever the app restarts.
SECRET_KEY=
# 1 only when CampusHub is served over HTTPS
SESSION_COOKIE_SECURE=0
# Set to 1 to see detailed errors while developing
FLASK_DEBUG=0
