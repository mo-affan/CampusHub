# MySQL connection used by CampusHub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campushub

# Optional
DB_POOL_SIZE=5
# Flask session signing key - change it if you ever run CampusHub outside your laptop
SECRET_KEY=change-me
# Set to 1 to see detailed errors while developing
FLASK_DEBUG=0
